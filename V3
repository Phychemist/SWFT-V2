< !DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Seragen SWFT — Platform Preview</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><style>:root {
    --primary-50: #fef2f4;
    --primary-100: #fde6e9;
    --primary-200: #fbd0d8;
    --primary-500: #e85a71;
    --primary-600: #d43d5a;
    --primary-700: #b22d49;
    --accent-50: #fdf2f8;
    --accent-100: #fce7f3;
    --accent-200: #fbcfe8;
    --accent-500: #ec4899;
    --accent-600: #db2777;
    --accent-700: #be185d;
    --gray-50: #f9fafb;
    --gray-100: #f3f4f6;
    --gray-200: #e5e7eb;
    --gray-300: #d1d5db;
    --gray-400: #9ca3af;
    --gray-500: #6b7280;
    --gray-600: #4b5563;
    --gray-700: #374151;
    --gray-800: #1f2937;
    --gray-900: #111827;
    --success-50: #ecfdf5;
    --success-500: #10b981;
    --success-600: #059669;
    --success-700: #047857;
    --warning-50: #fffbeb;
    --warning-500: #f59e0b;
    --warning-600: #d97706;
    --error-50: #fef2f2;
    --error-500: #ef4444;
    --error-600: #dc2626;
    --error-700: #b91c1c;
    --blue-50: #eff6ff;
    --blue-500: #3b82f6;
    --blue-600: #2563eb;
    --blue-700: #1d4ed8;
    --purple-50: #f5f3ff;
    --purple-600: #7c3aed;
    --bg: #f8fafc;
    --surface: #fff;
    --border-light: #e5e7eb;
    --border-default: #d1d5db;
    --text-primary: #111827;
    --text-secondary: #4b5563;
    --text-muted: #9ca3af;
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0/.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0/.1), 0 2px 4px -2px rgb(0 0 0/.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0/.1), 0 4px 6px -4px rgb(0 0 0/.1);
    --sidebar: 260px;
    --header: 64px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0
}

body {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    background: var(--bg);
    color: var(--text-primary);
    -webkit-font-smoothing: antialiased
}

/* Role switcher */
.role-bar {
    background: var(--gray-900);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    font-size: 12px
}

.role-bar span {
    color: var(--gray-400);
    font-weight: 500
}

.role-btn {
    padding: 5px 14px;
    border-radius: 6px;
    border: none;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    color: var(--gray-300);
    background: transparent;
    transition: all .15s
}

.role-btn:hover {
    background: var(--gray-700)
}

.role-btn.active {
    background: var(--primary-600);
    color: #fff
}

/* Layout */
.sidebar {
    position: fixed;
    left: 0;
    top: 40px;
    width: var(--sidebar);
    height: calc(100vh - 40px);
    background: var(--surface);
    border-right: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    z-index: 40
}

.sidebar-logo {
    height: var(--header);
    display: flex;
    align-items: center;
    padding: 0 24px;
    border-bottom: 1px solid var(--border-light)
}

.logo-text {
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-600);
    letter-spacing: -0.5px
}

.sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 14px 12px
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: background .15s, color .15s;
    color: var(--text-secondary);
    font-size: 13.5px;
    font-weight: 500;
    margin-bottom: 2px;
    user-select: none
}

.nav-item:hover {
    background: var(--gray-50);
    color: var(--text-primary)
}

.nav-item.active {
    background: var(--primary-50);
    color: var(--primary-700)
}

.nav-item.active svg {
    color: var(--primary-600)
}

.nav-item svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0
}

.nav-badge {
    margin-left: auto;
    background: var(--accent-500);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 99px
}

.sidebar-footer {
    padding: 14px 16px;
    border-top: 1px solid var(--border-light);
    font-size: 12px;
    color: var(--text-muted);
    text-align: center
}

.topbar {
    position: fixed;
    top: 40px;
    left: var(--sidebar);
    right: 0;
    height: var(--header);
    background: var(--surface);
    border-bottom: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    z-index: 30
}

.topbar-title {
    font-size: 16px;
    font-weight: 600
}

.user-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 8px;
    cursor: pointer
}

.user-pill:hover {
    background: var(--gray-50)
}

.avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-400), var(--primary-600));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 12px;
    font-weight: 700
}

.user-info .name {
    font-size: 13px;
    font-weight: 500
}

.user-info .role-badge {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 99px;
    font-weight: 600;
    display: inline-block;
    margin-top: 1px
}

.badge-accountant {
    background: var(--accent-100);
    color: var(--accent-700)
}

.badge-fe {
    background: var(--blue-50);
    color: var(--blue-700)
}

.badge-backoffice {
    background: var(--purple-50);
    color: var(--purple-600)
}

.badge-manager {
    background: #f0fdf4;
    color: var(--success-700)
}

.main {
    margin-left: var(--sidebar);
    margin-top: calc(40px + var(--header));
    padding: 28px 32px;
    min-height: calc(100vh - 40px - var(--header))
}

/* Page header */
.page-hdr {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 24px;
    gap: 16px
}

.page-hdr h1 {
    font-size: 22px;
    font-weight: 700
}

.page-hdr p {
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 3px
}

.hdr-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-shrink: 0
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    font-family: inherit;
    transition: all .15s;
    white-space: nowrap
}

.btn-primary {
    background: var(--accent-600);
    color: #fff
}

.btn-primary:hover {
    background: var(--accent-700)
}

.btn-coral {
    background: var(--primary-600);
    color: #fff
}

.btn-coral:hover {
    background: var(--primary-700)
}

.btn-secondary {
    background: var(--gray-100);
    color: var(--gray-700);
    border: 1px solid var(--gray-200)
}

.btn-secondary:hover {
    background: var(--gray-200)
}

.btn-outline {
    background: transparent;
    color: var(--gray-700);
    border: 1px solid var(--border-default)
}

.btn-outline:hover {
    background: var(--gray-50)
}

.btn-danger {
    background: var(--error-600);
    color: #fff
}

.btn-danger:hover {
    background: var(--error-700)
}

.btn-success {
    background: var(--success-600);
    color: #fff
}

.btn-success:hover {
    background: var(--success-700)
}

.btn-sm {
    padding: 5px 12px;
    font-size: 12px
}

.btn svg {
    width: 14px;
    height: 14px
}

/* Stats */
.stats-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px
}

.stats-grid-5 {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-bottom: 24px
}

.stats-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px
}

.stat-card {
    background: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 18px 20px;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: 14px
}

.stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 20px
}

.stat-body {}

.stat-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: 4px
}

.stat-value {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.5px
}

.stat-sub {
    font-size: 11.5px;
    color: var(--text-muted);
    margin-top: 2px
}

/* Tabs */
.tabs-pill {
    display: flex;
    gap: 2px;
    background: var(--gray-100);
    border-radius: 8px;
    padding: 3px;
    margin-bottom: 20px;
    width: fit-content
}

.tab-pill {
    padding: 7px 18px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    color: var(--text-secondary);
    transition: all .15s;
    white-space: nowrap;
    user-select: none
}

.tab-pill.active {
    background: var(--surface);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm)
}

/* Filter pills (claims style) */
.filter-pills {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    align-items: center
}

.fpill {
    padding: 7px 18px;
    border-radius: 99px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--border-default);
    background: var(--surface);
    color: var(--text-secondary);
    transition: all .15s
}

.fpill.active {
    background: var(--primary-600);
    color: #fff;
    border-color: var(--primary-600)
}

.fpill-accent.active {
    background: var(--accent-600);
    color: #fff;
    border-color: var(--accent-600)
}

/* Table */
.table-wrap {
    background: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-sm)
}

.table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-light);
    gap: 12px;
    flex-wrap: wrap
}

.toolbar-left {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap
}

.search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    background: var(--surface);
    width: 220px
}

.search-box input {
    border: none;
    outline: none;
    background: transparent;
    font-size: 13px;
    font-family: inherit;
    width: 100%;
    color: var(--text-primary)
}

.search-box svg {
    width: 14px;
    height: 14px;
    color: var(--text-muted);
    flex-shrink: 0
}

.fselect {
    padding: 7px 12px;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    color: var(--text-primary);
    background: var(--surface);
    cursor: pointer;
    outline: none
}

.fselect:focus {
    border-color: var(--primary-400)
}

.date-pair {
    display: flex;
    align-items: center;
    gap: 8px
}

.date-pair input {
    padding: 7px 10px;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    color: var(--text-primary);
    background: var(--surface);
    width: 130px
}

.date-pair span {
    font-size: 12px;
    color: var(--text-muted)
}

table {
    width: 100%;
    border-collapse: collapse
}

thead th {
    padding: 11px 16px;
    text-align: left;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .04em;
    background: var(--gray-50);
    border-bottom: 1px solid var(--border-light)
}

tbody tr {
    border-bottom: 1px solid var(--border-light);
    transition: background .1s
}

tbody tr:last-child {
    border-bottom: none
}

tbody tr:hover {
    background: var(--gray-50)
}

td {
    padding: 12px 16px;
    font-size: 13px;
    color: var(--text-primary);
    vertical-align: middle
}

.td-muted {
    color: var(--text-secondary)
}

.td-sm {
    font-size: 11.5px;
    color: var(--text-muted);
    margin-top: 2px
}

/* Badges */
.badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 99px;
    font-size: 11.5px;
    font-weight: 600
}

.badge-pink {
    background: var(--accent-100);
    color: var(--accent-700)
}

.badge-coral {
    background: var(--primary-100);
    color: var(--primary-700)
}

.badge-green {
    background: var(--success-50);
    color: var(--success-700)
}

.badge-red {
    background: var(--error-50);
    color: var(--error-700)
}

.badge-amber {
    background: var(--warning-50);
    color: var(--warning-600)
}

.badge-gray {
    background: var(--gray-100);
    color: var(--gray-600)
}

.badge-blue {
    background: var(--blue-50);
    color: var(--blue-700)
}

/* Amounts */
.amt-green {
    color: var(--success-600);
    font-weight: 600
}

.amt-red {
    color: var(--error-600);
    font-weight: 600
}

.amt-dark {
    color: var(--gray-800);
    font-weight: 600
}

/* Pagination */
.pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-top: 1px solid var(--border-light);
    font-size: 13px;
    color: var(--text-secondary)
}

.page-btns {
    display: flex;
    gap: 4px
}

.page-btn {
    padding: 5px 10px;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    background: var(--surface);
    color: var(--text-secondary);
    transition: all .15s
}

.page-btn:hover {
    background: var(--gray-50)
}

.page-btn.active {
    background: var(--primary-600);
    color: #fff;
    border-color: var(--primary-600)
}

/* Modal */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .45);
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px
}

.modal-overlay.open {
    display: flex
}

.modal {
    background: var(--surface);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 520px;
    max-height: 90vh;
    overflow-y: auto;
    animation: scaleIn .18s ease
}

.modal-xl {
    max-width: 700px
}

.modal-lg {
    max-width: 600px
}

@keyframes scaleIn {
    from {
        opacity: 0;
        transform: scale(.96)
    }

    to {
        opacity: 1;
        transform: scale(1)
    }
}

.modal-hdr {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 20px 24px 16px;
    border-bottom: 1px solid var(--border-light);
    gap: 12px
}

.modal-hdr h2 {
    font-size: 16px;
    font-weight: 700
}

.modal-hdr .modal-sub {
    font-size: 12.5px;
    color: var(--primary-600);
    margin-top: 2px
}

.modal-body {
    padding: 20px 24px
}

.modal-footer {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    padding: 16px 24px;
    border-top: 1px solid var(--border-light)
}

.close-btn {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: none;
    background: var(--gray-100);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font-size: 16px;
    flex-shrink: 0
}

.close-btn:hover {
    background: var(--gray-200)
}

/* Form */
.form-group {
    margin-bottom: 16px
}

.form-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: .03em
}

.form-input {
    width: 100%;
    padding: 9px 12px;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    color: var(--text-primary);
    outline: none;
    transition: border .15s;
    background: var(--surface)
}

.form-input:focus {
    border-color: var(--primary-400);
    box-shadow: 0 0 0 3px rgba(232, 90, 113, .08)
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px
}

.form-hint {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px
}

/* Claim form specific */
.claim-section {
    margin-bottom: 24px
}

.claim-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: .02em
}

.claim-section-title svg {
    width: 18px;
    height: 18px;
    color: var(--primary-600)
}

.toggle-row {
    background: var(--primary-50);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px
}

.toggle-info {
    font-size: 14px;
    font-weight: 600
}

.toggle-sub {
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 2px
}

.toggle-switch {
    width: 48px;
    height: 26px;
    background: var(--primary-600);
    border-radius: 99px;
    position: relative;
    cursor: pointer;
    flex-shrink: 0;
    transition: background .2s
}

.toggle-switch.off {
    background: var(--gray-300)
}

.toggle-knob {
    width: 20px;
    height: 20px;
    background: #fff;
    border-radius: 50%;
    position: absolute;
    top: 3px;
    left: 25px;
    transition: left .2s;
    box-shadow: 0 1px 3px rgb(0 0 0/.2)
}

.toggle-switch.off .toggle-knob {
    left: 3px
}

.from-to {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px
}

.petrol-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: end
}

.petrol-amount {
    background: var(--gray-50);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 13px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: space-between
}

.petrol-amount .amt {
    color: var(--primary-600);
    font-weight: 600
}

.food-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--gray-100)
}

.food-row:last-child {
    border-bottom: none
}

.food-name {
    font-size: 13px;
    font-weight: 500
}

.food-max {
    font-size: 11px;
    color: var(--text-muted)
}

.food-input {
    width: 140px;
    padding: 7px 12px;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    text-align: right
}

.reimb-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--gray-100)
}

.reimb-row:last-child {
    border-bottom: none
}

.upload-area {
    border: 2px dashed var(--primary-300);
    background: var(--primary-50);
    border-radius: 12px;
    padding: 28px;
    text-align: center;
