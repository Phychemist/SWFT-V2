    }

    const titleEl=document.getElementById(role+'-title') if(titleEl&&titles[page])titleEl.textContent=titles[page]
}

function showTab(group, tab, el) {
    const parent=el.closest('.role-pages')||document.body const contents=document.querySelectorAll('[id^="' +group+'-"]') contents.forEach(c=> {
            if(c.classList.contains('tab-content'))c.classList.remove('active')
        }) const target=document.getElementById(group+'-' +tab) if(target)target.classList.add('active') const pills=el.closest('.tabs-pill')||el.parentElement pills.querySelectorAll('.tab-pill').forEach(p=>p.classList.remove('active')) el.classList.add('active')
}

function toggleFilterPill(el) {
    el.closest('div').querySelectorAll('.tab-pill').forEach(p=>p.classList.remove('active')) el.classList.add('active')
}

function setFpill(el) {
    el.closest('.filter-pills').querySelectorAll('.fpill').forEach(p=>p.classList.remove('active')) el.classList.add('active')
}

function toggleMulti() {
    const on=document.getElementById('multiCheck').checked document.getElementById('single-alloc').style.display=on?'none': 'block'
        document.getElementById('multi-alloc').style.display=on?'block':'none'
}

function toggleSame() {
    const on=event.target.checked document.getElementById('same-amt').style.display=on?'block': 'none'
        document.getElementById('per-user').style.display=on?'none':'block'
}

let petrolAmt=0 function toggleOutstation() {
    const t=document.getElementById('outstationToggle') const f=document.getElementById('outstation-fields') t.classList.toggle('off') const isOn= !t.classList.contains('off') f.style.display=isOn?'block': 'none'
}

// start toggle in ON state (matching screenshot)
document.getElementById('outstation-fields').style.display='block'

function calcPetrol(el) {
    const km=parseFloat(el.value)||0 petrolAmt=km*4 document.getElementById('petrol-amt').textContent='₹'+petrolAmt.toFixed(2) updateTotal()
}

function updateTotal() {
    let total=petrolAmt // food + reimbursement rows

    document.querySelectorAll('#claimFormModal .food-input').forEach(i=> {
            total+=parseFloat(i.value)||0
        }) // accommodation, travel, misc — tagged with class claim-amt

    document.querySelectorAll('#claimFormModal .claim-amt').forEach(i=> {
            total+=parseFloat(i.value)||0
        }) document.getElementById('claim-total').textContent='₹'+total.toFixed(2)
}

function addReimbItem() {
    const c=document.getElementById('reimb-items') const d=document.createElement('div') d.className='reimb-row'
    d.innerHTML='<input class="form-input" style="flex:1;margin-right:8px" placeholder="Item name"><input class="food-input" type="number" value="0" oninput="updateTotal()">'
    c.appendChild(d)
}

function showInvPreview(val) {
    document.getElementById('inv-preview-area').style.display=val?'block': 'none'
        document.getElementById('genInvBtn').disabled= !val
}

function openTicketModal(type) {
    document.getElementById('tkt-inprogress').style.display=type==='inprogress' ? 'block': 'none'
        document.getElementById('tkt-completed').style.display=type==='completed' ? 'block': 'none'
        // reset any open override forms
        document.getElementById('override-form-1').style.display='none'
        document.getElementById('override-form-2').style.display='none'
        openModal('ticketDetailModal')
}

function showOverrideForm(n) {
    document.getElementById('override-form-' +n).style.display='block'
}

function submitOverride(n) {
    const qty=document.getElementById('override-qty-' +n).value const reason=document.getElementById('override-reason-' +n).value if( !reason.trim()) {
        showToast('Reason is required to override');
        return
    }

    // Update the displayed quantity cell
    document.getElementById('qty-used-' +n).innerHTML='<span style="background:var(--warning-50);color:var(--warning-600);font-weight:600;padding:4px 12px;border-radius:6px">'+qty+' <span style="font-size:10px">(overridden)</span></span>'
    // Swap status badge
    const row=document.getElementById('override-row-' +n) row.querySelector('.badge').className='badge badge-amber'
    row.querySelector('.badge').textContent='Overridden'
    // Hide form, disable override button
    document.getElementById('override-form-' +n).style.display='none'
    row.querySelector('button').disabled=true row.querySelector('button').textContent='Done'
    showToast('Override saved successfully')
}

</script></body></html>